# LIOS Development Environment
# Copy to .dev.env and fill in values
# Usage: podman compose --env-file .dev.env -f compose.dev.yaml up -d

# Database password (dev uses a simple password, matches compose.dev.yaml)
POSTGRES_PASSWORD=devpass

# APNs push -- optional. The relay starts and works fine with these left empty; it just
# sends no push to iOS devices in that case. See relay/config/config.yaml for what each is.
LIOS_APNS_KEY_ID=
LIOS_APNS_TEAM_ID=
LIOS_APNS_AUTH_KEY_B64=
