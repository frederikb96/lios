# LIOS Production Environment
# Copy to .prod.env and fill in values
# Usage: podman compose --env-file .prod.env up -d

# Database password (use a strong password for production)
POSTGRES_PASSWORD=

# APNs push -- optional. The relay starts and works fine with these left empty; it just
# sends no push to iOS devices in that case. See relay/config/config.yaml for what each is.
LIOS_APNS_KEY_ID=
LIOS_APNS_TEAM_ID=
LIOS_APNS_AUTH_KEY_B64=
