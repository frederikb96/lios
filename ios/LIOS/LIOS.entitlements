<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>production</string>
	<!-- No App Group exists for com.frederikberg.lios — Apple's appGroups endpoint does not exist
	     in the App Store Connect API at all, and creating one is a manual
	     portal step nobody has done. A Keychain access group needs only a shared team, which
	     all three targets already have, and is what lets the app, the share extension and the
	     notification service extension all read the same group key and device credential. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.frederikberg.lios</string>
	</array>
</dict>
</plist>
