{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Berlin",
  "schedule": ["* * * * 6"],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "branchConcurrentLimit": 0,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "osvVulnerabilityAlerts": true,
  "labels": ["dependencies", "renovate"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool versions installed by name in the CI workflow",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yaml$/"],
      "matchStrings": ["#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+?)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*[A-Z_]+_VERSION:\\s*\"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "{{{datasource}}}"
    }
  ],
  "packageRules": [
    {
      "description": "Patch updates: no delay",
      "matchUpdateTypes": ["patch"],
      "automerge": false,
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "Minor updates: 14-day stability window",
      "matchUpdateTypes": ["minor"],
      "automerge": false,
      "minimumReleaseAge": "14 days"
    },
    {
      "description": "Major updates: 30-day stability window",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "minimumReleaseAge": "30 days"
    }
  ]
}
